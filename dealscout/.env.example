# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_COMPANIES=companies-events
KAFKA_TOPIC_FINANCIAL=financial-events
KAFKA_TOPIC_NEWS=news-events

# ---- MinIO (S3-compatible storage) ----
MINIO_ROOT_USER=dealscout
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver

# ---- Analytics warehouse (Gold layer) ----
WAREHOUSE_TYPE=postgresql
DATABASE_URL=postgresql://dealscout:changeme@postgres:5432/dealscout_db

# ---- External APIs (optionnelles, versions gratuites) ----
FINANCIAL_API_KEY=your_alpha_vantage_or_fmp_key
NEWS_API_KEY=your_newsapi_key

# ---- Backend / JWT ----
SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Airflow ----
AIRFLOW_UID=50000
