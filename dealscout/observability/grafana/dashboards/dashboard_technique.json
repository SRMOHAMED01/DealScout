{
  "id": null,
  "uid": "dealscout-technique",
  "title": "DealScout — Technical Dashboard",
  "timezone": "Europe/Paris",
  "panels": [
    {
      "type": "stat",
      "title": "API Latence (p95)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 }
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Taux d'erreur API",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_total[5m])) * 100",
          "legendFormat": "error rate %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 } },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Kafka Lag",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{topic}} {{consumergroup}}"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "DAG Airflow Dernière Exécution",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "airflow_dag_last_success",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Durée des Jobs Spark",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (job) (spark_job_duration_seconds)",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Requêtes API par Endpoint",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{handler}}"
        }
      ],
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "schemaVersion": 38,
  "version": 1
}
