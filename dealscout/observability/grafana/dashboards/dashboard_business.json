{
  "id": null,
  "uid": "dealscout-business",
  "title": "DealScout — Business Dashboard",
  "timezone": "Europe/Paris",
  "panels": [
    {
      "type": "stat",
      "title": "Entreprises Analysées",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(dealscout_companies_total)",
          "legendFormat": "entreprises"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Cibles Prioritaires",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(dealscout_priority_targets_total)",
          "legendFormat": "cibles prioritaires"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Score M&A Moyen",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(dealscout_ma_score_avg)",
          "legendFormat": "score moyen"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1 }
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Score M&A par Secteur",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (sector) (dealscout_ma_score_avg)",
          "legendFormat": "{{sector}}"
        }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
    },
    {
      "type": "barchart",
      "title": "Top Opportunités",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(10, dealscout_ma_score)",
          "legendFormat": "{{company}}"
        }
      ],
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 }
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1
}
